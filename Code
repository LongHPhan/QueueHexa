//Check address on PCA
Adafruit_PWMServoDriver pwm1 = Adafruit_PWMServoDriver(0x40);
Adafruit_PWMServoDriver pwm2 = Adafruit_PWMServoDriver(0x41);


//go in clockwise
#define COXA1  0
#define FEMUR1 1
#define TIBIA1 2

#define COXA2  4
#define FEMUR2 5
#define TIBIA2 6

#define COXA3  12
#define FEMUR3 13
#define TIBIA3 14

#define COXA4  16
#define FEMUR4 17
#define TIBIA4 18

#define COXA5  20
#define FEMUR5 21
#define TIBIA5 22

#define COXA6  28
#define FEMUR6 29
#define TIBIA6 30

//Calibration variables
#define COXA_LENGTH  43
#define FEMUR_LENGTH 82.5
#define TIBIA_LENGTH 107

#define SERVOMIN 59
#define SERVOMAX 520

#define SERVOMIN_35 140
#define SERVOMAX_35 460

const double STANCE_X = 101;
const double STANCE_Y = -73; //90,90+45,90-30
const double STANCE_Z = 0;

//0 to change starting index
double LEG_X[7] = {0,STANCE_X,STANCE_X,STANCE_X,STANCE_X,STANCE_X,STANCE_X};
double LEG_Y[7] = {0,STANCE_Y,STANCE_Y,STANCE_Y,STANCE_Y,STANCE_Y,STANCE_Y};
double LEG_Z[7] = {0,STANCE_Z,STANCE_Z,STANCE_Z,STANCE_Z,STANCE_Z,STANCE_Z};

unsigned long PREVIOUS_TIME[7] = {0,0,0,0,0,0,0};

const uint8_t COXA[] = {
    0,COXA1, COXA2, COXA3,
    COXA4, COXA5, COXA6
};
const uint8_t FEMUR[] = {
    0,FEMUR1, FEMUR2, FEMUR3,
    FEMUR4, FEMUR5, FEMUR6
};
const uint8_t TIBIA[] = {
    0,TIBIA1, TIBIA2, TIBIA3,
    TIBIA4, TIBIA5, TIBIA6
};

const int switchPin = 2;

//equations
double DISTANCE(double x1,double y1, double z1,double x2,double y2, double z2){
  //Distance formula
  return sqrt(pow(x1-x2, 2) + pow(y1-y2, 2) + pow(z1-z2, 2));
}
double LAW_COS(double A,double B,double C){
  //law of cosine
  double value = (pow(A,2)-(pow(B,2)+pow(C,2)))/(-2*B*C);

  value = constrain(value,-1,1);

  return acos(value)*180.0/PI;
}

//*************
//BASIC CONTROL
//*************

//only the x position is needed to be flip
bool LEFT_SIDE[7] = {false,true,false,false,true,true,false};



void setAngle(uint8_t servo, double angle){
    int board = servo / 16;
    int channel = servo % 16;

    // Invert femurs
    if (servo == FEMUR1 || servo == FEMUR2 || servo == FEMUR3 || servo == FEMUR4 || servo == FEMUR5 ||servo == FEMUR6){
        angle = 180 - angle;
    }

    int pulse = 0;

    pulse = map(angle, 0, 180, SERVOMIN, SERVOMAX);
    

    if (board == 0){
        pwm1.setPWM(channel, 0, pulse);
    }
    else{
        pwm2.setPWM(channel, 0, pulse);
    }
}

void UPDATE_LEG_POSITION(int leg_number,double x, double y,double z){
  LEG_X[leg_number] = x;
  LEG_Y[leg_number] = y;
  LEG_Z[leg_number] = z;
}

void INVERSE_KINEMATICS(int leg_number,double x, double y, double z){
  //Given points, find angle and move tip to point
  double COXA_ANGLE = atan2(z, x)*180.0 / PI + 90;
  double C_LENGTH = DISTANCE(x,y,z,COXA_LENGTH*cos((COXA_ANGLE - 90)*PI/180),0,COXA_LENGTH*sin((COXA_ANGLE - 90)*PI/180));
  double FEMUR_ANGLE = LAW_COS(TIBIA_LENGTH,FEMUR_LENGTH,C_LENGTH) + acos(constrain(-y/C_LENGTH,-1,1))*180.0/PI;
  double TIBIA_ANGLE = LAW_COS(C_LENGTH,TIBIA_LENGTH,FEMUR_LENGTH) - 90;

  // Invert coxa on legs 1, 3, and 5
  if (LEFT_SIDE[leg_number]) {
      COXA_ANGLE = 180 - COXA_ANGLE;
  }

  setAngle(FEMUR[leg_number],round(FEMUR_ANGLE));
  setAngle(COXA[leg_number],round(COXA_ANGLE));
  //+90 to represent that at 90 tibia is not straight
  setAngle(TIBIA[leg_number],round(TIBIA_ANGLE+90));
}

const double STEP_SIZE = 5;      // mm per update
const unsigned long UPDATE_TIME = 30; // ms between updates
bool MOVE_TIP(int leg_number, double x, double y, double z) {
  //interpolate version of IK, return true when position is reached.
  //Otherwise, do action until its reached
  //update leg position too
  if (millis() - PREVIOUS_TIME[leg_number] >= UPDATE_TIME){
    PREVIOUS_TIME[leg_number]=millis();

    //find unit vector 1/D <x-xc,y-yc,z-zc>
    double D = DISTANCE(LEG_X[leg_number],LEG_Y[leg_number],LEG_Z[leg_number],x,y,z);
    double dx = x-LEG_X[leg_number];
    double dy = y-LEG_Y[leg_number];
    double dz = z-LEG_Z[leg_number];

    
    //case: distance is less than step size
    if (D <= STEP_SIZE){
      INVERSE_KINEMATICS(leg_number, x, y, z);
      UPDATE_LEG_POSITION(leg_number, x, y, z);
      return true;
    }

    double x1 = LEG_X[leg_number]+ (dx/D)*STEP_SIZE;
    double y1 = LEG_Y[leg_number]+ (dy/D)*STEP_SIZE;
    double z1 = LEG_Z[leg_number]+ (dz/D)*STEP_SIZE;
    INVERSE_KINEMATICS(leg_number,x1, y1, z1);

    UPDATE_LEG_POSITION(leg_number, x1, y1, z1);
    return false;
  }
  return false;
}


//************
//GAIT MACHINE
//************

//how far forward and backward leg gonna
const double STRIDE = 60;
const double LIFT_HEIGHT = 20;
//rougly half of stride for best result
const double ROTATION_SPEED = 30;

//stores LIFT (0),SWING (1),LOWER,PUSH as numbers (used in switch statement, better reability)
enum PHASE{
  LIFT,
  SWING,
  LOWER,
  PUSH,
  STANCE
}; 
enum ROTATION{
  CW = 1,CCW = -1
};

PHASE LEG_PHASE[7] = {LIFT,LIFT,LOWER,LIFT,LOWER,LIFT,LOWER};
bool PHASE_DONE[7] = {false,false,false,false,false,false,false};

//rotational offset for the front and back needs to be shorten, since the shape is more of a rectangle.


void UPDATE_LEG_PHASE(int leg_number,double moving_angle, int rotation_direction, double movement_scale, double rotation_scale){
  //responbile for the trajectory and current state of one leg
  //only tell when leg is done, not responsible for changing the state
  // moving angle is meant for omni movement, 0 means horizonntally right, 90 means straigth forward...
  //angle are already changed in GAIT();

  //ROTATIONAL, only need z
  double ROTATION_Z = (rotation_direction * ROTATION_SPEED /2)*rotation_scale;
  if (LEFT_SIDE[leg_number]) {
    ROTATION_Z = -ROTATION_Z;
  }

  //If LEFT then direction = -1
  double X_DIRECTION = LEFT_SIDE[leg_number] ? -1 :1;

  //check if this affects while rotating
  double MOVEMENT_Z = (STRIDE/2)*sin(moving_angle)*movement_scale;

  double MOVEMENT_X = X_DIRECTION*(STRIDE/2)*cos(moving_angle)*movement_scale;


  //X control left or right
  //Z control forward and back
  //use for y, if both sticks are centered then y will stop
  bool moving = movement_scale > 0 || rotation_scale > 0;
  double SWING_Y = moving ? STANCE_Y + LIFT_HEIGHT : STANCE_Y;
  double SWING_Z =  STANCE_Z + MOVEMENT_Z + ROTATION_Z;
  double SWING_X = STANCE_X + MOVEMENT_X;

  double PUSH_Z =  STANCE_Z - MOVEMENT_Z - ROTATION_Z;
  double PUSH_X = STANCE_X -MOVEMENT_X;

  if(PHASE_DONE[leg_number]){
    return;
  }
  switch(LEG_PHASE[leg_number]){
    case LIFT:
      //repeats until true, how MOVE_TIP works
      if (MOVE_TIP(leg_number, STANCE_X, SWING_Y, STANCE_Z)) {
        PHASE_DONE[leg_number] = true;
      }
      break;

    case SWING:
      if (MOVE_TIP(leg_number,SWING_X , SWING_Y, SWING_Z)) {
          PHASE_DONE[leg_number] = true;
        }
        break;

    case LOWER:
      if (MOVE_TIP(leg_number, SWING_X , STANCE_Y, SWING_Z)){
        PHASE_DONE[leg_number] = true;
      }

    case PUSH:
      if (MOVE_TIP(leg_number, PUSH_X , STANCE_Y, PUSH_Z)) {
        PHASE_DONE[leg_number] = true;
      }
      break;
  }
}

void RETURN_TO_STANCE(){
  for(int i =1;i<=6;i++){
    MOVE_TIP(i,STANCE_X,STANCE_Y,STANCE_Z);
  }
}

PHASE NEXT_PHASE(int phase){
    //just change the phase for gait
    switch(phase){
        case LIFT:  
          return SWING;
        case SWING:
          return LOWER;
        case LOWER: 
          return PUSH;
        case PUSH:  
          return LIFT;
    }
    return LIFT; // should never happen
}

void GAIT(double moving_angle, int rotation_direction, double movement_scale, double rotation_scale){
  //coordinate all 6 leg into specific pattern
  //tell when to change phase too
  //gives angle to move
  
  // convert degrees to radians
  double angle_rad = moving_angle * PI / 180.0;

  UPDATE_LEG_PHASE(1,angle_rad,rotation_direction, movement_scale, rotation_scale);
  UPDATE_LEG_PHASE(3,angle_rad,rotation_direction, movement_scale, rotation_scale);
  UPDATE_LEG_PHASE(5,angle_rad,rotation_direction, movement_scale, rotation_scale);

  if(PHASE_DONE[1] && PHASE_DONE[3] && PHASE_DONE[5] && PHASE_DONE[2] && PHASE_DONE[4] && PHASE_DONE[6]){
    PHASE_DONE[1] = false;
    PHASE_DONE[3] = false;
    PHASE_DONE[5] = false;

    LEG_PHASE[1] = NEXT_PHASE(LEG_PHASE[1]);
    LEG_PHASE[3] = NEXT_PHASE(LEG_PHASE[3]);
    LEG_PHASE[5] = NEXT_PHASE(LEG_PHASE[5]);

    PHASE_DONE[2] = false;
    PHASE_DONE[4] = false;
    PHASE_DONE[6] = false;
    LEG_PHASE[2] = NEXT_PHASE(LEG_PHASE[2]);
    LEG_PHASE[4] = NEXT_PHASE(LEG_PHASE[4]);
    LEG_PHASE[6] = NEXT_PHASE(LEG_PHASE[6]);
  }

  UPDATE_LEG_PHASE(2,angle_rad,rotation_direction, movement_scale, rotation_scale);
  UPDATE_LEG_PHASE(4,angle_rad,rotation_direction, movement_scale, rotation_scale);
  UPDATE_LEG_PHASE(6,angle_rad,rotation_direction, movement_scale, rotation_scale);

}


void setup(){
  Serial.begin(9600);
  pinMode(switchPin, INPUT_PULLUP);
  pwm1.begin();
  pwm1.setPWMFreq(50);  
  pwm2.begin();
  pwm2.setPWMFreq(50);

  controller.begin();
  Serial.println("Starting BLE Gamepad Client...");
}

void loop() {
  if (controller.isConnected()) {
    XboxControlsState state;
    controller.read(&state);

    double lx = state.leftStickX;
    double ly = state.leftStickY;
    double rx = state.rightStickX;
    double ry = state.rightStickY;



    int rotation_direction = rx >= 0 ? CCW: CW;

    double left_stick_magnitude = sqrt(lx*lx + ly*ly);
    double right_stick_magnitude = sqrt(rx*rx + ry*ry);
    
    double movement_scale = 0;
    double rotation_scale = 0;
    if (left_stick_magnitude < 0.1) {
      movement_scale = 0;
    }
    else if (left_stick_magnitude < 0.5) {
      movement_scale = 0.5;
    }
    else {
      movement_scale = 1;
    }

    if (right_stick_magnitude < 0.1) {
      rotation_scale = 0;
    }
    else if (right_stick_magnitude < 0.5) {
      rotation_scale = 0.5;
    }
    else {
      rotation_scale = 1;
    }


    int angle = atan2(ly, lx) * 180.0 / PI;
    GAIT(angle,rotation_direction,movement_scale,rotation_scale);

  }
  else {
    Serial.println("Controller not connected");
  }
  delay(10);
}
